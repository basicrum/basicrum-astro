{
  "name": "@basicrum/astro",
  "version": "0.1.0",
  "description": "Basicrum real user monitoring for Astro with non-consent and consent-controlled loaders.",
  "homepage": "https://github.com/basicrum/basicrum-astro#readme",
  "bugs": {
    "url": "https://github.com/basicrum/basicrum-astro/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/basicrum/basicrum-astro.git"
  },
  "type": "module",
  "license": "GPL-2.0-or-later",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    }
  },
  "files": [
    "dist",
    "vendor",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "peerDependencies": {
    "astro": "^7.0.0"
  },
  "devDependencies": {
    "@astrojs/node": "11.1.7",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "acorn": "8.18.0",
    "astro": "7.3.8",
    "eslint": "10.11.0",
    "globals": "17.13.0",
    "publint": "0.3.25",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0"
  },
  "scripts": {
    "test": "npm run conventions && npm run typecheck && npm run lint && npm run lint:package && npm run test:unit && npm run test:browser",
    "test:unit": "npm run build && node --test tests/unit/*.test.js",
    "test:browser": "playwright test",
    "test:integration": "playwright test --project browser",
    "test:e2e": "playwright test --project e2e",
    "typecheck": "npm run build && tsc -p tests/tsconfig.json",
    "lint": "eslint .",
    "conventions": "sh tools/verify-ascii.sh && sh tools/verify-version-consistency.sh && sh tools/verify-boomerang-provenance.sh",
    "verify:package": "node tools/verify-package.mjs",
    "example:dev": "npm run build && astro dev --root examples/basic",
    "example:build": "npm run build && astro build --root examples/basic",
    "build": "node tools/build.mjs",
    "prepare": "npm run build",
    "lint:package": "npm run build && publint --strict --pack npm"
  },
  "keywords": [
    "astro-integration",
    "astro",
    "basicrum",
    "boomerang",
    "rum",
    "performance"
  ],
  "publishConfig": {
    "access": "public"
  }
}
