{
  "name": "@basicrum/astro",
  "version": "0.1.0",
  "description": "Basicrum real user monitoring for Astro with standard and consent-controlled loaders.",
  "homepage": "https://github.com/basicrum/basicrum-astro#readme",
  "bugs": {
    "url": "https://github.com/basicrum/basicrum-astro/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/basicrum/basicrum-astro.git"
  },
  "type": "module",
  "license": "GPL-2.0-or-later",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./client": {
      "types": "./src/client.d.ts",
      "default": "./src/client.js"
    }
  },
  "files": [
    "src",
    "vendor",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "peerDependencies": {
    "astro": "^7.0.0"
  },
  "devDependencies": {
    "@astrojs/node": "11.1.6",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "astro": "7.3.5",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "typescript": "7.0.2"
  },
  "scripts": {
    "test": "npm run conventions && npm run typecheck && npm run lint && npm run test:unit && npm run test:browser",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:browser": "playwright test",
    "test:integration": "playwright test --project browser",
    "test:e2e": "playwright test --project e2e",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "conventions": "sh tools/verify-ascii.sh && sh tools/verify-version-consistency.sh && sh tools/verify-boomerang-provenance.sh",
    "verify:package": "node tools/verify-package.mjs",
    "example:dev": "astro dev --root examples/basic",
    "example:build": "astro build --root examples/basic"
  },
  "keywords": [
    "astro-integration",
    "astro",
    "basicrum",
    "boomerang",
    "rum",
    "performance"
  ],
  "publishConfig": {
    "access": "public"
  }
}
